{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(npm --version)",
      "Bash(npm create:*)",
      "Bash(npm install:*)",
      "Bash(python -c \"import fastapi; print\\(''FastAPI:'', fastapi.__version__\\)\")",
      "Bash(python:*)",
      "Bash(pip install:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)"
    ]
  }
}
